    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^27.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "eslint": "^9.39.1",
    "@eslint/js": "^9.39.1",
    "typescript-eslint": "^8.72.1",
    "eslint-plugin-react-hooks": "^7.0.1",
